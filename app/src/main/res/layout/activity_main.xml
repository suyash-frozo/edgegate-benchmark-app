<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101922">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EdgeGate Benchmark"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On-device AI model testing"
            android:textColor="#92adc9"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Device Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detecting..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Device Profile Card -->
        <LinearLayout
            android:id="@+id/cardDeviceProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DEVICE PROFILE"
                    android:textColor="#92adc9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvToggleProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expand"
                    android:textColor="#2b8cee"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeviceProfileSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyzing device..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvDeviceProfileFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- EdgeGate Connection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDGEGATE SERVER"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="https://edgegateapi.frozo.ai"
                android:text="https://edgegateapi.frozo.ai"
                android:textColor="#FFFFFF"
                android:textColorHint="#56697d"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:inputType="textUri"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="API Key or JWT Token"
                android:textColor="#FFFFFF"
                android:textColorHint="#56697d"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:inputType="textPassword"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkspaceId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Workspace ID"
                android:text="7479eff9-985a-49c0-b3a0-5e5b3885a5a7"
                android:textColor="#FFFFFF"
                android:textColorHint="#56697d"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Connect &amp; Fetch Models"
                android:backgroundTint="#2b8cee"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Model Selection Card -->
        <LinearLayout
            android:id="@+id/cardModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODEL"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerModels"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_bg"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR LOAD FROM DEVICE"
                android:textColor="#56697d"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnPickFile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Pick .tflite / .onnx from device"
                android:backgroundTint="#334155"
                android:textColor="#92adc9"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSelectedFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#25e2f4"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELEGATES"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <CheckBox
                    android:id="@+id/cbCpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU"
                    android:textColor="#FFFFFF"
                    android:checked="true"
                    android:buttonTint="#2b8cee"
                    android:layout_marginEnd="16dp" />

                <CheckBox
                    android:id="@+id/cbGpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPU"
                    android:textColor="#FFFFFF"
                    android:checked="true"
                    android:buttonTint="#2b8cee"
                    android:layout_marginEnd="16dp" />

                <CheckBox
                    android:id="@+id/cbNnapi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NNAPI (NPU)"
                    android:textColor="#FFFFFF"
                    android:checked="true"
                    android:buttonTint="#2b8cee" />
            </LinearLayout>

            <!-- Quality Gates Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUALITY GATES"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Preset:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical" />

                <Spinner
                    android:id="@+id/spinnerGatePreset"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="3"
                    android:background="@drawable/input_bg"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Custom gates container (visible when "Custom" preset selected) -->
            <LinearLayout
                android:id="@+id/layoutCustomGates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Dynamic gate rows added programmatically -->
                <LinearLayout
                    android:id="@+id/gateRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnAddGate"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="+ Add Gate"
                        android:backgroundTint="#334155"
                        android:textColor="#25e2f4"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnRemoveGate"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="- Remove Gate"
                        android:backgroundTint="#334155"
                        android:textColor="#ef4444"
                        android:textSize="12sp"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnBenchmark"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Run Benchmark"
                android:backgroundTint="#10b981"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- LLM Benchmark Card -->
        <LinearLayout
            android:id="@+id/cardLlm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LLM BENCHMARK"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnPickGguf"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Pick .gguf model from device"
                android:backgroundTint="#334155"
                android:textColor="#92adc9"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSelectedGguf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#25e2f4"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLlmPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Test prompt..."
                android:text="Explain edge AI in one sentence."
                android:textColor="#FFFFFF"
                android:textColorHint="#56697d"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:minLines="2"
                android:gravity="top"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max tokens: "
                    android:textColor="#92adc9"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMaxTokens"
                    android:layout_width="80dp"
                    android:layout_height="36dp"
                    android:text="64"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@drawable/input_bg"
                    android:padding="8dp"
                    android:inputType="number" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Threads: "
                    android:textColor="#92adc9"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLlmThreads"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@drawable/input_bg"
                    android:padding="8dp"
                    android:inputType="number" />
            </LinearLayout>

            <Button
                android:id="@+id/btnRunLlm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Run LLM Benchmark"
                android:backgroundTint="#8b5cf6"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- LLM Results Card -->
        <LinearLayout
            android:id="@+id/cardLlmResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LLM RESULTS"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLlmResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminateTint="#2b8cee"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#92adc9"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Results Card -->
        <LinearLayout
            android:id="@+id/cardResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BENCHMARK RESULTS"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Gate Results Card -->
        <LinearLayout
            android:id="@+id/cardGateResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUALITY GATE RESULTS"
                android:textColor="#92adc9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvGateResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Report Button -->
        <Button
            android:id="@+id/btnReport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Report to EdgeGate"
            android:backgroundTint="#2b8cee"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
